<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>圆几何台球 3.0 · 交互式几何实验室</title>
    <style>
        * { box-sizing: border-box; user-select: none; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
            transition: background 0.2s, color 0.2s;
        }
        body.light-mode { background: #e8f0e8; color: #1e2a1e; }
        body.dark-mode { background: #121212; color: #e0e0e0; }
        
        .game-container {
            max-width: 1400px;
            margin: 20px auto;
            background: white;
            border-radius: 32px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 20px;
            transition: background 0.2s;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        body.dark-mode .game-container { background: #2a2a2f; }
        
        .game-main { flex: 3; min-width: 280px; }
        .right-panel {
            flex: 1.2;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .angle-history-panel, .achievements-panel {
            background: #f0f4f0;
            border-radius: 28px;
            padding: 16px;
            font-size: 0.9rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        body.dark-mode .angle-history-panel, body.dark-mode .achievements-panel { background: #3a3a3a; }
        .history-title, .achievements-title {
            font-weight: bold;
            margin-bottom: 10px;
            border-bottom: 2px solid #ffaa33;
            display: inline-block;
        }
        .history-list, .achievements-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .history-list li, .achievements-list li {
            font-family: monospace;
            padding: 4px 0;
            border-bottom: 1px solid #ccc;
        }
        .achievement-locked { opacity: 0.5; }
        .achievement-unlocked { color: #ffaa33; font-weight: bold; }
        .achievement-desc { font-size: 0.7rem; color: #888; margin-left: 8px; }
        
        .mobile-controls { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; align-items: center; }
        button, .mode-btn {
            background: #eef2f6;
            border: none;
            padding: 6px 14px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
        }
        body.dark-mode button { background: #444; color: white; }
        .mode-active { background: #ffaa33; color: #2c2c2c; }
        .canvas-wrapper {
            position: relative;
            margin: 10px 0;
            border-radius: 20px;
            overflow: hidden;
            border: 2px solid #2e8b57;
            background: #1e4d2b;
        }
        canvas { display: block; width: 100%; height: auto; cursor: crosshair; touch-action: none; }
        .info-panel {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: space-between;
            background: #f8faff;
            padding: 10px 18px;
            border-radius: 48px;
            margin: 12px 0;
        }
        body.dark-mode .info-panel { background: #3a3a4a; }
        .score-area { font-size: 1.4rem; font-weight: bold; }
        .control-group { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .geom-tools { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
        footer { text-align: center; font-size: 0.7rem; margin-top: 20px; opacity: 0.6; }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: #fff8e7;
            border-radius: 32px;
            max-width: 550px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            padding: 28px 24px;
        }
        body.dark-mode .modal-content { background: #2a2a2f; color: #f0f0f0; border: 1px solid #ffaa33; }
        .close-modal-btn { background: #ffaa33; border: none; padding: 8px 20px; border-radius: 40px; cursor: pointer; }
        @media (max-width: 800px) { .game-container { flex-direction: column; } }
    </style>
</head>
<body class="light-mode">
<div class="game-container">
    <div class="game-main">
        <div class="header-bar" style="display:flex; justify-content:space-between; flex-wrap:wrap;">
            <div class="title">
                <h1 id="mainTitle">🎯 圆几何台球 3.0 · 声光交互实验室</h1>
                <p id="subtitle">反射定律 | 圆周角 | 垂径定理 | 音效反馈 | 成就系统 | 慢动作回放</p>
            </div>
            <div class="toolbar">
                <button id="langBtn">🌐 中文/EN</button>
                <button id="themeBtn">🌙 深色</button>
                <button id="soundToggleBtn">🔊 音效开</button>
                <button id="rulesBtn">📜 规则</button>
                <button id="undoBtn">↩️ 撤销</button>
                <button id="replayBtn">🎬 回放上一杆</button>
            </div>
        </div>
        <div class="canvas-wrapper" style="position:relative;">
            <canvas id="gameCanvas" width="1000" height="550"></canvas>
            <canvas id="powerRing" width="1000" height="550" style="position:absolute; top:0; left:0; pointer-events:none;"></canvas>
        </div>
        <div class="info-panel">
            <div class="score-area">⭐ <span id="scoreValue">0</span> &nbsp;| 🎯 <span id="challengeName">自由模式</span></div>
            <div class="control-group">
                <span id="modeLabel">🎮 游戏模式:</span>
                <button id="modeFree" class="mode-btn">自由</button>
                <button id="modeReflect1" class="mode-btn">反射1次</button>
                <button id="modeReflect2" class="mode-btn">反射2次</button>
                <button id="modeTangent" class="mode-btn">切线狙击</button>
                <button id="modeAngle" class="mode-btn">圆周角探索</button>
                <button id="modeChord" class="mode-btn">垂径定理</button>
                <button id="modeLab" class="mode-btn">🔬 反射定律实验室</button>
            </div>
            <div class="control-group">
                <span id="speedLabel">🐢 动画速度:</span>
                <input type="range" id="speedSlider" min="0.3" max="1.5" step="0.01" value="1.0" style="width:100px">
                <span id="speedVal">1.0x</span>
                <span id="powerLabel">🎯 力度:</span>
                <input type="range" id="powerSlider" min="0" max="100" value="0" style="width:100px">
                <span id="powerVal">0%</span>
            </div>
        </div>
        <div class="geom-tools">
            <label><input type="checkbox" id="showGrid" checked> <span id="gridLabel">极坐标网格</span></label>
            <label><input type="checkbox" id="showRuler" checked> <span id="rulerLabel">几何标尺</span></label>
            <label><input type="checkbox" id="showTangentHelper" checked> <span id="tangentLabel">常驻法线/切线</span></label>
            <label><input type="checkbox" id="showPredict" checked> <span id="predictLabel">轨迹预测(含反射角)</span></label>
            <label><input type="checkbox" id="showParticles" checked> <span id="particleLabel">碰撞粒子特效</span></label>
            <button id="resetBtn">🔄 <span id="resetText">重置球局</span></button>
            <button id="helpBtn">❓ <span id="helpText">定理提示</span></button>
        </div>
        <div class="mobile-controls">
            <span id="dirLabel">📱 辅助方向:</span>
            <button id="dirUp">↑</button><button id="dirLeft">←</button><button id="dirRight">→</button><button id="dirDown">↓</button>
            <span id="powerHintLabel">力度:</span>
            <input type="range" id="mobilePowerSlider" min="0" max="100" value="80" style="width:80px">
            <span id="mobilePowerVal">80%</span>
            <button id="dirShoot" style="background:#ffaa33;" id="shootBtn">击球</button>
        </div>
        <footer id="footerText">✨ 点击白球拖拽瞄准 → 释放击球 | 碰撞音效 + 粒子特效 | 右侧成就系统 | 慢动作回放</footer>
    </div>

    <div class="right-panel">
        <div class="angle-history-panel">
            <div class="history-title" id="historyTitle">📊 最近碰撞角度</div>
            <ul class="history-list" id="angleHistoryList"><li>— 暂无碰撞 —</li></ul>
            <div style="margin-top:12px; font-size:0.8rem;" id="modeSpecificInfo"></div>
        </div>
        <div class="achievements-panel">
            <div class="achievements-title" id="achievementsTitle">🏆 成就徽章</div>
            <ul class="achievements-list" id="achievementsList"></ul>
        </div>
    </div>
</div>

<div id="rulesModal" class="modal"><div class="modal-content"><h2 id="rulesModalTitle">📜 游戏规则</h2><div id="rulesModalContent"></div><button class="close-modal-btn" id="closeRulesBtn">关闭</button></div></div>

<script>
    (function(){
        // ---------- 画布与物理参数 ----------
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const powerRingCanvas = document.getElementById('powerRing');
        const ringCtx = powerRingCanvas.getContext('2d');
        const width = canvas.width, height = canvas.height;
        const center = { x: width/2, y: height/2 };
        const R = Math.min(width, height) * 0.4;
        const circle = { x: center.x, y: center.y, r: R };
        const ballR = 10;
        let whiteBall = { x: circle.x, y: circle.y - 70, vx: 0, vy: 0 };
        let targetBall = { x: circle.x + 60, y: circle.y + 40, r: 9 };
        
        // 游戏状态
        let score = 0;
        let isAiming = false;
        let aimEnd = { x: 0, y: 0 };
        let isMoving = false;
        let friction = 0.985;
        let animFrame = null;
        let speedFactor = 1.0;
        let currentMode = 'free';   
        let currentCollisions = 0;
        let lastCollisionFrame = false;
        
        // 历史记录 & 回放
        let historyStack = [];
        let replayFrames = [];
        let isReplaying = false;
        
        // 几何特效
        let collisionEffect = { active: false, point: null, normal: null, tangent: null, timer: 0, incAngle: 0, refAngle: 0 };
        let lastCollisionGeom = null;
        let angleHistory = [];
        
        // 圆周角模式数据
        let angleModePoints = { A: null, B: null };
        // 垂径模式弦
        let chordForMode = null;
        // 反射实验室模式: 目标扇形区域
        let labTargetArc = { startAngle: 0, endAngle: 0, active: false };
        
        // UI 开关
        let showGrid = true, showRuler = true, showTangentHelper = true, showPredict = true, showParticles = true;
        let particles = [];
        
        // 音效系统
        let audioCtx = null;
        let soundEnabled = true;
        function initAudio() {
            if(audioCtx) return;
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        function playSound(type) {
            if(!soundEnabled || !audioCtx) return;
            const now = audioCtx.currentTime;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            let freq = 800, duration = 0.15;
            switch(type){
                case 'collision': freq = 600; duration = 0.1; break;
                case 'score': freq = 1200; duration = 0.2; break;
                case 'fail': freq = 300; duration = 0.2; break;
                case 'mode': freq = 500; duration = 0.08; break;
                case 'undo': freq = 400; duration = 0.1; break;
                default: freq = 800;
            }
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.2, now);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
            osc.start();
            osc.stop(now + duration);
        }
        
        // 成就系统
        let achievements = {
            perfectTangent: false,
            reflectMaster: false,
            distanceKiller: false,
            labMaster: false
        };
        let consecutiveReflectSuccess = 0;
        function unlockAchievement(id) {
            if(achievements[id]) return;
            achievements[id] = true;
            playSound('score');
            showTip(getAchievementUnlockMsg(id), 2000);
            updateAchievementsUI();
            localStorage.setItem('achievements3', JSON.stringify(achievements));
        }
        function getAchievementUnlockMsg(id) {
            const msgs = {
                perfectTangent: lang === 'zh' ? '🏆 解锁成就: 完美切线' : '🏆 Achievement: Perfect Tangent',
                reflectMaster: lang === 'zh' ? '🏆 解锁成就: 反射大师' : '🏆 Achievement: Reflection Master',
                distanceKiller: lang === 'zh' ? '🏆 解锁成就: 圆心距杀手' : '🏆 Achievement: Distance Killer',
                labMaster: lang === 'zh' ? '🏆 解锁成就: 实验室征服者' : '🏆 Achievement: Lab Conqueror'
            };
            return msgs[id] || id;
        }
        function getAchievementDesc(id) {
            const desc = {
                perfectTangent: lang === 'zh' ? '切线狙击模式成功一次' : 'Success in Tangent Sniper mode',
                reflectMaster: lang === 'zh' ? '连续3次在反射挑战中得分' : 'Score 3 times in a row in Bounce Challenge',
                distanceKiller: lang === 'zh' ? '得分倍率达到1.8倍以上' : 'Score multiplier above 1.8',
                labMaster: lang === 'zh' ? '完成反射定律实验室挑战' : 'Complete Reflection Lab challenge'
            };
            return desc[id] || '';
        }
        function updateAchievementsUI() {
            const list = document.getElementById('achievementsList');
            list.innerHTML = `
                <li class="${achievements.perfectTangent ? 'achievement-unlocked' : 'achievement-locked'}">
                    ✂️ ${lang === 'zh' ? '完美切线' : 'Perfect Tangent'}
                    <span class="achievement-desc">${getAchievementDesc('perfectTangent')}</span>
                </li>
                <li class="${achievements.reflectMaster ? 'achievement-unlocked' : 'achievement-locked'}">
                    🔄 ${lang === 'zh' ? '反射大师' : 'Reflection Master'}
                    <span class="achievement-desc">${getAchievementDesc('reflectMaster')}</span>
                </li>
                <li class="${achievements.distanceKiller ? 'achievement-unlocked' : 'achievement-locked'}">
                    🎯 ${lang === 'zh' ? '圆心距杀手' : 'Distance Killer'}
                    <span class="achievement-desc">${getAchievementDesc('distanceKiller')}</span>
                </li>
                <li class="${achievements.labMaster ? 'achievement-unlocked' : 'achievement-locked'}">
                    🔬 ${lang === 'zh' ? '实验室征服者' : 'Lab Conqueror'}
                    <span class="achievement-desc">${getAchievementDesc('labMaster')}</span>
                </li>
            `;
        }
        
        // 多语言
        let lang = 'zh';
        const i18n = {
            zh: {
                mainTitle: "🎯 圆几何台球 3.0 · 声光交互实验室",
                subtitle: "反射定律 | 圆周角 | 垂径定理 | 音效反馈 | 成就系统 | 慢动作回放",
                modeLabel: "🎮 游戏模式:",
                speedLabel: "🐢 动画速度:",
                powerLabel: "🎯 力度:",
                gridLabel: "极坐标网格",
                rulerLabel: "几何标尺",
                tangentLabel: "常驻法线/切线",
                predictLabel: "轨迹预测(含反射角)",
                particleLabel: "碰撞粒子特效",
                resetText: "重置球局",
                helpText: "定理提示",
                footer: "✨ 点击白球拖拽瞄准 → 释放击球 | 碰撞音效 + 粒子特效 | 右侧成就系统 | 慢动作回放",
                rulesTitle: "📜 游戏规则",
                free: "自由模式",
                reflect1: "反射1次",
                reflect2: "反射2次",
                tangent: "切线狙击",
                angle: "圆周角探索",
                chord: "垂径定理",
                lab: "🔬 反射定律实验室",
                ruleFree: "✨ 任意次数碰撞边界后击中红球即可得分。<br>📍 圆心距倍率：白球越靠近圆心，得分倍率越高（最高2.0倍）。",
                ruleReflect1: "🔄 必须碰撞边界 <strong>1次</strong> 后再击中红球。",
                ruleReflect2: "🔄 必须碰撞边界 <strong>2次</strong> 后再击中红球。",
                ruleTangent: "✂️ 白球路径必须与红球相切（擦过），系统会提示“半径⊥切线”。",
                ruleAngle: "📐 击中红球时，自动显示圆弧所对圆周角和圆心角，验证定理。",
                ruleChord: "📏 白球路径需垂直平分一条弦（经过圆心）。",
                ruleLab: "🎯 必须让白球碰撞边界后，反射路径击中绿色扇形目标区。",
                powerHint: "💪 满力度击球可轻松实现2~3次反射。",
                theme: "🌙 深色",
                rules: "📜 规则",
                undo: "↩️ 撤销",
                replay: "🎬 回放上一杆",
                soundOn: "🔊 音效开",
                soundOff: "🔇 音效关",
                historyTitle: "📊 最近碰撞角度",
                achievementsTitle: "🏆 成就徽章",
                dirLabel: "📱 辅助方向:",
                powerHintLabel: "力度:",
                shootBtn: "击球",
                angleRecord: "入射 {inc}° / 反射 {ref}°",
                noCollision: "— 暂无碰撞 —",
                challengeFail: "❌ 挑战失败",
                scoreMsg: "🎉 得分 +{add}！ 倍率 {mult}",
                modeAngleInfo: "圆周角模式: 固定两点(红色标记), 击中红球后显示圆周角/圆心角",
                modeChordInfo: "垂径定理模式: 蓝色弦为目标, 白球路径需垂直平分该弦(经过圆心)",
                modeLabInfo: "🎯 反射定律实验室: 使反射路径击中绿色扇形区域"
            },
            en: {
                mainTitle: "🎯 Circle Geometry Billiards 3.0 · Interactive Lab",
                subtitle: "Reflection Law | Inscribed Angle | Chord Theorem | Sound Effects | Achievements | Slow-mo Replay",
                modeLabel: "🎮 Game Mode:",
                speedLabel: "🐢 Animation Speed:",
                powerLabel: "🎯 Power:",
                gridLabel: "Polar Grid",
                rulerLabel: "Ruler",
                tangentLabel: "Keep Last Normal/Tangent",
                predictLabel: "Trajectory Prediction (w/ angles)",
                particleLabel: "Collision Particles",
                resetText: "Reset Game",
                helpText: "Theorem Tips",
                footer: "✨ Drag from white ball → release to shoot | Collision sound + particles | Achievements | Replay",
                rulesTitle: "📜 Game Rules",
                free: "Free Mode",
                reflect1: "1 Bounce",
                reflect2: "2 Bounces",
                tangent: "Tangent Sniper",
                angle: "Inscribed Angle",
                chord: "Perp. Bisector",
                lab: "🔬 Reflection Lab",
                ruleFree: "✨ Hit red ball after any number of bounces.<br>📍 Distance multiplier: closer to center → higher score (up to 2.0x).",
                ruleReflect1: "🔄 Must bounce exactly <strong>1 time</strong> before hitting red ball.",
                ruleReflect2: "🔄 Must bounce exactly <strong>2 times</strong> before hitting red ball.",
                ruleTangent: "✂️ White ball path must be tangent to red ball (grazing).",
                ruleAngle: "📐 When hitting red ball, displays inscribed/central angle to verify theorem.",
                ruleChord: "📏 White ball path must perpendicularly bisect a chord (pass through center).",
                ruleLab: "🎯 Must bounce then reflect into green sector target.",
                powerHint: "💪 Max power easily achieves 2-3 reflections.",
                theme: "🌙 Dark",
                rules: "📜 Rules",
                undo: "↩️ Undo",
                replay: "🎬 Replay Last Shot",
                soundOn: "🔊 Sound On",
                soundOff: "🔇 Sound Off",
                historyTitle: "📊 Recent Collision Angles",
                achievementsTitle: "🏆 Achievements",
                dirLabel: "📱 Direction:",
                powerHintLabel: "Power:",
                shootBtn: "Shoot",
                angleRecord: "Inc {inc}° / Ref {ref}°",
                noCollision: "— No collisions —",
                challengeFail: "❌ Challenge failed",
                scoreMsg: "🎉 Score +{add}! Multiplier {mult}",
                modeAngleInfo: "Inscribed Angle Mode: Two fixed points (red marks). Hit red ball to see inscribed/central angle.",
                modeChordInfo: "Perp. Bisector Mode: Blue chord target. White path must bisect it through center.",
                modeLabInfo: "🎯 Reflection Lab: Make the reflected path hit the green sector."
            }
        };
        
        function updateLanguage(){
            const t = i18n[lang];
            document.getElementById('mainTitle').innerText = t.mainTitle;
            document.getElementById('subtitle').innerText = t.subtitle;
            document.getElementById('modeLabel').innerText = t.modeLabel;
            document.getElementById('speedLabel').innerText = t.speedLabel;
            document.getElementById('powerLabel').innerText = t.powerLabel;
            document.getElementById('gridLabel').innerText = t.gridLabel;
            document.getElementById('rulerLabel').innerText = t.rulerLabel;
            document.getElementById('tangentLabel').innerText = t.tangentLabel;
            document.getElementById('predictLabel').innerText = t.predictLabel;
            document.getElementById('particleLabel').innerText = t.particleLabel;
            document.getElementById('resetText').innerText = t.resetText;
            document.getElementById('helpText').innerText = t.helpText;
            document.getElementById('footerText').innerHTML = t.footer;
            document.getElementById('rulesModalTitle').innerHTML = t.rulesTitle;
            document.getElementById('historyTitle').innerHTML = t.historyTitle;
            document.getElementById('achievementsTitle').innerHTML = t.achievementsTitle;
            document.getElementById('dirLabel').innerHTML = t.dirLabel;
            document.getElementById('powerHintLabel').innerHTML = t.powerHintLabel;
            document.getElementById('dirShoot').innerHTML = t.shootBtn;
            document.getElementById('modeFree').innerHTML = t.free;
            document.getElementById('modeReflect1').innerHTML = t.reflect1;
            document.getElementById('modeReflect2').innerHTML = t.reflect2;
            document.getElementById('modeTangent').innerHTML = t.tangent;
            document.getElementById('modeAngle').innerHTML = t.angle;
            document.getElementById('modeChord').innerHTML = t.chord;
            document.getElementById('modeLab').innerHTML = t.lab;
            document.getElementById('challengeName').innerText = t[currentMode] || t.free;
            document.getElementById('themeBtn').innerHTML = t.theme;
            document.getElementById('rulesBtn').innerHTML = t.rules;
            document.getElementById('undoBtn').innerHTML = t.undo;
            document.getElementById('replayBtn').innerHTML = t.replay;
            document.getElementById('soundToggleBtn').innerHTML = soundEnabled ? t.soundOn : t.soundOff;
            updateRulesModal();
            updateAngleHistoryUI();
            updateModeSpecificInfo();
            updateAchievementsUI();
        }
        
        function updateRulesModal(){
            const t = i18n[lang];
            document.getElementById('rulesModalContent').innerHTML = `
                <div class="rule-section">
                    <strong>${t.free}</strong><br>${t.ruleFree}<br><br>
                    <strong>${t.reflect1}</strong><br>${t.ruleReflect1}<br><br>
                    <strong>${t.reflect2}</strong><br>${t.ruleReflect2}<br><br>
                    <strong>${t.tangent}</strong><br>${t.ruleTangent}<br><br>
                    <strong>${t.angle}</strong><br>${t.ruleAngle}<br><br>
                    <strong>${t.chord}</strong><br>${t.ruleChord}<br><br>
                    <strong>${t.lab}</strong><br>${t.ruleLab}<br><br>
                    <span style="color:#d9534f;">${t.powerHint}</span>
                </div>
            `;
        }
        
        function updateAngleHistoryUI(){
            const t = i18n[lang];
            const list = document.getElementById('angleHistoryList');
            if(angleHistory.length === 0){
                list.innerHTML = `<li>${t.noCollision}</li>`;
                return;
            }
            list.innerHTML = angleHistory.map(h => `<li>${t.angleRecord.replace('{inc}', h.inc).replace('{ref}', h.ref)}</li>`).join('');
        }
        
        function updateModeSpecificInfo(){
            const t = i18n[lang];
            const infoDiv = document.getElementById('modeSpecificInfo');
            if(currentMode === 'angle'){
                infoDiv.innerHTML = `<span style="color:#ffaa33;">📐 ${t.modeAngleInfo}</span>`;
            } else if(currentMode === 'chord'){
                infoDiv.innerHTML = `<span style="color:#88ffaa;">📏 ${t.modeChordInfo}</span>`;
            } else if(currentMode === 'lab'){
                infoDiv.innerHTML = `<span style="color:#88ffaa;">🎯 ${t.modeLabInfo}</span>`;
            } else {
                infoDiv.innerHTML = '';
            }
        }
        
        // 辅助函数
        function clampInside(p, margin=ballR){
            let dx = p.x - circle.x, dy = p.y - circle.y, dist = Math.hypot(dx,dy);
            if(dist + margin > circle.r){
                let ang = Math.atan2(dy,dx);
                p.x = circle.x + (circle.r - margin) * Math.cos(ang);
                p.y = circle.y + (circle.r - margin) * Math.sin(ang);
            }
        }
        
        function saveState(){
            historyStack.push({
                white: { x: whiteBall.x, y: whiteBall.y, vx: whiteBall.vx, vy: whiteBall.vy },
                target: { x: targetBall.x, y: targetBall.y },
                score: score,
                collisions: currentCollisions
            });
            if(historyStack.length > 20) historyStack.shift();
        }
        
        function undo(){
            if(historyStack.length === 0) return;
            let state = historyStack.pop();
            whiteBall.x = state.white.x; whiteBall.y = state.white.y;
            whiteBall.vx = state.white.vx; whiteBall.vy = state.white.vy;
            targetBall.x = state.target.x; targetBall.y = state.target.y;
            score = state.score; currentCollisions = state.collisions;
            scoreSpan.innerText = score;
            isMoving = false;
            if(animFrame) cancelAnimationFrame(animFrame);
            playSound('undo');
            drawCanvas();
        }
        
        function resetGame(){
            saveState();
            isMoving = false;
            whiteBall.vx = 0; whiteBall.vy = 0;
            whiteBall.x = circle.x; whiteBall.y = circle.y - 70;
            clampInside(whiteBall, ballR);
            do{
                targetBall.x = circle.x + (Math.random()*2-1)*(R-35);
                targetBall.y = circle.y + (Math.random()*2-1)*(R-35);
            }while(Math.hypot(targetBall.x-whiteBall.x, targetBall.y-whiteBall.y) < 35 || Math.hypot(targetBall.x-circle.x,targetBall.y-circle.y)+targetBall.r > R-2);
            clampInside(targetBall, targetBall.r);
            currentCollisions = 0;
            collisionEffect.active = false;
            particles = [];
            if(currentMode === 'angle'){
                let ang1 = 30 * Math.PI/180, ang2 = 150 * Math.PI/180;
                angleModePoints.A = { x: circle.x + R*Math.cos(ang1), y: circle.y + R*Math.sin(ang1) };
                angleModePoints.B = { x: circle.x + R*Math.cos(ang2), y: circle.y + R*Math.sin(ang2) };
            } else if(currentMode === 'chord'){
                let theta = Math.random() * Math.PI * 2;
                let d = R * (0.2 + Math.random() * 0.6);
                let midX = circle.x + d * Math.cos(theta);
                let midY = circle.y + d * Math.sin(theta);
                let perpAng = theta + Math.PI/2;
                let halfLen = Math.sqrt(R*R - d*d);
                let p1 = { x: midX + halfLen * Math.cos(perpAng), y: midY + halfLen * Math.sin(perpAng) };
                let p2 = { x: midX - halfLen * Math.cos(perpAng), y: midY - halfLen * Math.sin(perpAng) };
                chordForMode = { p1, p2, mid: {x:midX,y:midY}, slope: perpAng };
            } else if(currentMode === 'lab'){
                labTargetArc.active = true;
                labTargetArc.startAngle = Math.random() * Math.PI * 2;
                labTargetArc.endAngle = labTargetArc.startAngle + Math.PI/3;
                if(labTargetArc.endAngle > 2*Math.PI) labTargetArc.endAngle -= 2*Math.PI;
            }
            drawCanvas();
        }
        
        function recordFrame(){
            replayFrames.push({ white: { x: whiteBall.x, y: whiteBall.y }, target: { x: targetBall.x, y: targetBall.y }, collision: collisionEffect.active });
            if(replayFrames.length > 600) replayFrames.shift();
        }
        function startReplay(){
            if(replayFrames.length === 0) { showTip(lang === 'zh' ? "没有可回放的记录" : "No replay data", 1000); return; }
            isReplaying = true;
            let idx = 0;
            function step(){
                if(idx >= replayFrames.length) { isReplaying = false; drawCanvas(); return; }
                let f = replayFrames[idx];
                whiteBall.x = f.white.x; whiteBall.y = f.white.y;
                targetBall.x = f.target.x; targetBall.y = f.target.y;
                drawCanvas();
                idx++;
                setTimeout(step, 30 / speedFactor);
            }
            step();
        }
        
        function addParticles(x, y){
            if(!showParticles) return;
            for(let i=0;i<8;i++){
                particles.push({
                    x, y, vx: (Math.random()-0.5)*4, vy: (Math.random()-0.5)*4, life: 20
                });
            }
        }
        function updateParticles(){
            for(let i=0;i<particles.length;i++){
                particles[i].x += particles[i].vx;
                particles[i].y += particles[i].vy;
                particles[i].life--;
                if(particles[i].life<=0) particles.splice(i,1), i--;
            }
        }
        
        function handleCollision(){
            let dx = whiteBall.x - circle.x, dy = whiteBall.y - circle.y;
            let dist = Math.hypot(dx,dy);
            if(dist + ballR >= circle.r && dist > 1e-5){
                let nx = dx/dist, ny = dy/dist;
                whiteBall.x = circle.x + (circle.r - ballR) * nx;
                whiteBall.y = circle.y + (circle.r - ballR) * ny;
                let vmag = Math.hypot(whiteBall.vx, whiteBall.vy);
                let inc = 0;
                if(vmag>0.05){
                    let dot = (whiteBall.vx*nx + whiteBall.vy*ny)/vmag;
                    inc = Math.acos(Math.min(1,Math.abs(dot))) * 180/Math.PI;
                }
                let vdotn = whiteBall.vx*nx + whiteBall.vy*ny;
                if(vdotn > 0){
                    whiteBall.vx -= 2*vdotn*nx;
                    whiteBall.vy -= 2*vdotn*ny;
                }
                let cp = { x: circle.x + circle.r*nx, y: circle.y + circle.r*ny };
                let tx = -ny, ty = nx;
                collisionEffect = { active: true, point: cp, normal: {x:nx,y:ny}, tangent:{x:tx,y:ty}, timer: 90, incAngle: inc, refAngle: inc };
                lastCollisionGeom = collisionEffect;
                angleHistory.unshift({ inc: inc.toFixed(1), ref: inc.toFixed(1) });
                if(angleHistory.length > 5) angleHistory.pop();
                updateAngleHistoryUI();
                playSound('collision');
                addParticles(cp.x, cp.y);
                if(isMoving && !lastCollisionFrame){
                    currentCollisions++;
                    lastCollisionFrame = true;
                }
                return true;
            }
            lastCollisionFrame = false;
            return false;
        }
        
        function checkScore(){
            let d = Math.hypot(whiteBall.x - targetBall.x, whiteBall.y - targetBall.y);
            if(d < ballR + targetBall.r){
                let success = false;
                if(currentMode === 'free') success = true;
                else if(currentMode === 'reflect1' && currentCollisions === 1) success = true;
                else if(currentMode === 'reflect2' && currentCollisions === 2) success = true;
                else if(currentMode === 'tangent'){
                    let distCenter = Math.hypot(whiteBall.x-targetBall.x, whiteBall.y-targetBall.y);
                    let velDir = Math.atan2(whiteBall.vy, whiteBall.vx);
                    let toTarget = Math.atan2(targetBall.y-whiteBall.y, targetBall.x-whiteBall.x);
                    let sinVal = Math.abs(Math.sin(velDir - toTarget));
                    if(Math.abs(distCenter - (ballR+targetBall.r)) < 5 && sinVal > 0.85) success = true;
                    if(success && !achievements.perfectTangent) unlockAchievement('perfectTangent');
                }
                else if(currentMode === 'angle') success = true;
                else if(currentMode === 'chord') success = true;
                else if(currentMode === 'lab'){
                    if(labTargetArc.active && lastCollisionGeom){
                        let angle = Math.atan2(lastCollisionGeom.point.y - circle.y, lastCollisionGeom.point.x - circle.x);
                        if(angle < 0) angle += 2*Math.PI;
                        let start = labTargetArc.startAngle, end = labTargetArc.endAngle;
                        if(start > end) end += 2*Math.PI;
                        let targetAngle = angle;
                        if(targetAngle < start && start > Math.PI) targetAngle += 2*Math.PI;
                        if(targetAngle >= start && targetAngle <= end) success = true;
                        if(success && !achievements.labMaster) unlockAchievement('labMaster');
                    }
                }
                
                if(success){
                    let distToCenter = Math.hypot(whiteBall.x-circle.x, whiteBall.y-circle.y);
                    let mult = 2.0 - 1.5 * (distToCenter / R);
                    mult = Math.min(2.0, Math.max(0.5, mult));
                    let add = Math.floor(1 + (mult-1)*10);
                    score += add;
                    scoreSpan.innerText = score;
                    playSound('score');
                    if(mult > 1.8 && !achievements.distanceKiller) unlockAchievement('distanceKiller');
                    consecutiveReflectSuccess++;
                    if(consecutiveReflectSuccess >= 3 && !achievements.reflectMaster) unlockAchievement('reflectMaster');
                    const t = i18n[lang];
                    showTip(t.scoreMsg.replace('{add}', add).replace('{mult}', mult.toFixed(2)), 1500);
                    if(currentMode === 'angle' && angleModePoints.A && angleModePoints.B){
                        let P = { x: whiteBall.x, y: whiteBall.y };
                        let angleAPB = computeInscribedAngle(angleModePoints.A, angleModePoints.B, P);
                        let centerAngle = computeCentralAngle(angleModePoints.A, angleModePoints.B);
                        showTip(`📐 ${lang === 'zh' ? '圆周角' : 'Inscribed'} = ${angleAPB.toFixed(1)}° , ${lang === 'zh' ? '圆心角' : 'Central'} = ${centerAngle.toFixed(1)}° , ${lang === 'zh' ? '比值' : 'Ratio'} = ${(centerAngle/angleAPB).toFixed(2)} (${lang === 'zh' ? '应为2' : 'should be 2'})`, 2500);
                    }
                    if(currentMode === 'chord' && chordForMode){
                        let throughCenter = Math.hypot(whiteBall.x - circle.x, whiteBall.y - circle.y) < ballR+2;
                        let chordDir = { x: chordForMode.p2.x - chordForMode.p1.x, y: chordForMode.p2.y - chordForMode.p1.y };
                        let velDir = { x: whiteBall.vx, y: whiteBall.vy };
                        let dot = velDir.x * chordDir.x + velDir.y * chordDir.y;
                        let isPerp = Math.abs(dot) < 0.5 && throughCenter;
                        if(throughCenter && isPerp) showTip(`✅ ${lang === 'zh' ? '垂径定理成立！' : 'Perpendicular bisector theorem holds!'}`, 2000);
                        else showTip(`❌ ${lang === 'zh' ? '未满足垂径条件' : 'Condition not met'}`, 2000);
                    }
                } else {
                    playSound('fail');
                    consecutiveReflectSuccess = 0;
                    showTip(i18n[lang].challengeFail, 1500);
                }
                // 重置红球
                do{
                    targetBall.x = circle.x + (Math.random()*2-1)*(R-35);
                    targetBall.y = circle.y + (Math.random()*2-1)*(R-35);
                }while(Math.hypot(targetBall.x-whiteBall.x, targetBall.y-whiteBall.y) < 35 || Math.hypot(targetBall.x-circle.x,targetBall.y-circle.y)+targetBall.r > R-2);
                clampInside(targetBall, targetBall.r);
                currentCollisions = 0;
                return true;
            }
            return false;
        }
        
        function computeInscribedAngle(A, B, P){
            let angA = Math.atan2(A.y - P.y, A.x - P.x);
            let angB = Math.atan2(B.y - P.y, B.x - P.x);
            let diff = Math.abs(angA - angB);
            if(diff > Math.PI) diff = 2*Math.PI - diff;
            return diff * 180 / Math.PI;
        }
        function computeCentralAngle(A, B){
            let angA = Math.atan2(A.y - circle.y, A.x - circle.x);
            let angB = Math.atan2(B.y - circle.y, B.x - circle.x);
            let diff = Math.abs(angA - angB);
            if(diff > Math.PI) diff = 2*Math.PI - diff;
            return diff * 180 / Math.PI;
        }
        
        let tipTimeout;
        function showTip(msg, duration){
            let tipDiv = document.getElementById('dynamicTip');
            if(!tipDiv){
                tipDiv = document.createElement('div');
                tipDiv.id = 'dynamicTip';
                tipDiv.style.position = 'fixed'; tipDiv.style.bottom = '20px'; tipDiv.style.right = '20px';
                tipDiv.style.background = '#333'; tipDiv.style.color = 'white'; tipDiv.style.padding = '10px 20px';
                tipDiv.style.borderRadius = '30px'; tipDiv.style.zIndex = '1000'; tipDiv.style.fontSize = '1rem';
                document.body.appendChild(tipDiv);
            }
            if(tipTimeout) clearTimeout(tipTimeout);
            tipDiv.innerText = msg;
            tipDiv.style.opacity = '1';
            tipTimeout = setTimeout(()=>{ tipDiv.style.opacity = '0'; }, duration);
        }
        
        function updatePhysics(){
            if(!isMoving) return;
            whiteBall.vx *= friction;
            whiteBall.vy *= friction;
            whiteBall.x += whiteBall.vx * speedFactor;
            whiteBall.y += whiteBall.vy * speedFactor;
            handleCollision();
            checkScore();
            if(Math.hypot(whiteBall.vx, whiteBall.vy) < 0.1){
                isMoving = false;
                whiteBall.vx = whiteBall.vy = 0;
                currentCollisions = 0;
            }
            if(collisionEffect.active){
                collisionEffect.timer--;
                if(collisionEffect.timer<=0) collisionEffect.active = false;
            }
            updateParticles();
            drawCanvas();
            recordFrame();
            if(isMoving) animFrame = requestAnimationFrame(updatePhysics);
        }
        
        function computePowerFromDrag(len){
            let ratio = Math.min(1, len / 80);
            let power = 16 * Math.pow(ratio, 1.5);
            return Math.min(16, power);
        }
        
        function shoot(vx, vy){
            if(isMoving) return;
            saveState();
            whiteBall.vx = vx;
            whiteBall.vy = vy;
            currentCollisions = 0;
            replayFrames = [];
            isMoving = true;
            if(animFrame) cancelAnimationFrame(animFrame);
            animFrame = requestAnimationFrame(updatePhysics);
        }
        
        function predictPath(startX, startY, vx, vy, maxSteps=4){
            let points = [{x:startX, y:startY}];
            let reflections = [];
            let pos = {x:startX, y:startY};
            let vel = {x:vx, y:vy};
            let bounce = 0, iter = 0;
            while(iter < 400 && bounce <= maxSteps){
                let newX = pos.x + vel.x * 0.8;
                let newY = pos.y + vel.y * 0.8;
                let dx = newX - circle.x, dy = newY - circle.y;
                let dist = Math.hypot(dx, dy);
                if(dist + ballR >= circle.r && dist > 1e-5){
                    let nx = dx/dist, ny = dy/dist;
                    let dot = vel.x*nx + vel.y*ny;
                    if(dot < 0){
                        let incAngle = Math.acos(Math.abs(dot) / Math.hypot(vel.x, vel.y)) * 180/Math.PI;
                        vel.x -= 2*dot*nx;
                        vel.y -= 2*dot*ny;
                        bounce++;
                        let cp = { x: circle.x + circle.r*nx, y: circle.y + circle.r*ny };
                        reflections.push({x:cp.x, y:cp.y, order: bounce, normal: {x:nx,y:ny}, incAngle: incAngle.toFixed(0)});
                        newX = circle.x + (circle.r - ballR - 1) * nx;
                        newY = circle.y + (circle.r - ballR - 1) * ny;
                    }
                }
                pos.x = newX; pos.y = newY;
                points.push({x:pos.x, y:pos.y});
                iter++;
                if(Math.hypot(vel.x, vel.y) < 0.05) break;
            }
            return { points, reflections };
        }
        
        function drawCanvas(){
            ctx.clearRect(0,0,width,height);
            const isDarkMode = document.body.classList.contains('dark-mode');
            ctx.fillStyle = isDarkMode ? '#1a2a1a' : '#2b5e3b';
            ctx.fillRect(0,0,width,height);
            ctx.save();
            ctx.beginPath(); ctx.arc(circle.x, circle.y, circle.r, 0, 2*Math.PI); ctx.clip();
            
            if(showGrid){
                ctx.strokeStyle = isDarkMode ? '#88aa88' : '#cceecc';
                ctx.lineWidth = 0.8;
                for(let r=30; r<=R; r+=30){ ctx.beginPath(); ctx.arc(circle.x, circle.y, r, 0, 2*Math.PI); ctx.stroke(); }
                for(let ang=0; ang<360; ang+=15){
                    let rad = ang*Math.PI/180;
                    let x2 = circle.x + R*Math.cos(rad), y2 = circle.y + R*Math.sin(rad);
                    ctx.beginPath(); ctx.moveTo(circle.x, circle.y); ctx.lineTo(x2, y2); ctx.stroke();
                }
            }
            
            if(showRuler){
                let d = Math.hypot(whiteBall.x-circle.x, whiteBall.y-circle.y);
                ctx.font = "12px monospace"; ctx.fillStyle = 'yellow';
                ctx.fillText(`d = ${d.toFixed(1)} / R = ${R.toFixed(1)}`, circle.x-40, circle.y-R-5);
                let chordLen = 2 * Math.sqrt(Math.max(0, R*R - d*d));
                ctx.fillText(`${lang === 'zh' ? '弦长' : 'Chord'} ≈ ${chordLen.toFixed(1)}`, circle.x-40, circle.y-R-20);
            }
            
            // 模式特殊绘制
            if(currentMode === 'angle' && angleModePoints.A && angleModePoints.B){
                ctx.beginPath(); ctx.arc(angleModePoints.A.x, angleModePoints.A.y, 6, 0, 2*Math.PI);
                ctx.fillStyle = '#ff6666'; ctx.fill();
                ctx.beginPath(); ctx.arc(angleModePoints.B.x, angleModePoints.B.y, 6, 0, 2*Math.PI);
                ctx.fill();
                ctx.fillStyle = 'white'; ctx.fillText('A', angleModePoints.A.x-4, angleModePoints.A.y-4);
                ctx.fillText('B', angleModePoints.B.x-4, angleModePoints.B.y-4);
            }
            if(currentMode === 'chord' && chordForMode){
                ctx.beginPath(); ctx.moveTo(chordForMode.p1.x, chordForMode.p1.y); ctx.lineTo(chordForMode.p2.x, chordForMode.p2.y);
                ctx.strokeStyle = '#3399ff'; ctx.lineWidth = 3; ctx.stroke();
                ctx.fillStyle = '#3399ff'; ctx.fillText('弦', (chordForMode.p1.x+chordForMode.p2.x)/2, (chordForMode.p1.y+chordForMode.p2.y)/2);
            }
            if(currentMode === 'lab' && labTargetArc.active){
                ctx.beginPath();
                ctx.arc(circle.x, circle.y, R, labTargetArc.startAngle, labTargetArc.endAngle);
                ctx.lineTo(circle.x, circle.y);
                ctx.fillStyle = 'rgba(100,255,100,0.3)';
                ctx.fill();
            }
            
            // 红球/白球
            ctx.beginPath(); ctx.arc(targetBall.x, targetBall.y, targetBall.r, 0, 2*Math.PI);
            ctx.fillStyle = '#e63946'; ctx.fill();
            ctx.beginPath(); ctx.arc(whiteBall.x, whiteBall.y, ballR, 0, 2*Math.PI);
            ctx.fillStyle = '#f8f9fa'; ctx.fill(); ctx.stroke();
            
            // 瞄准预测
            if(isAiming && aimEnd && showPredict){
                let dx = aimEnd.x - whiteBall.x, dy = aimEnd.y - whiteBall.y;
                let len = Math.hypot(dx, dy);
                if(len > 2){
                    let power = computePowerFromDrag(len);
                    let vx = dx/len * power, vy = dy/len * power;
                    let { points, reflections } = predictPath(whiteBall.x, whiteBall.y, vx, vy, 4);
                    ctx.beginPath(); ctx.setLineDash([8,6]); ctx.strokeStyle = '#88ff88'; ctx.lineWidth = 2;
                    for(let i=0;i<points.length-1;i++){
                        ctx.beginPath(); ctx.moveTo(points[i].x, points[i].y); ctx.lineTo(points[i+1].x, points[i+1].y); ctx.stroke();
                    }
                    for(let rp of reflections){
                        ctx.beginPath(); ctx.arc(rp.x, rp.y, 7, 0, 2*Math.PI);
                        ctx.fillStyle = '#ffaa33cc'; ctx.fill();
                        ctx.fillStyle = 'white'; ctx.font = 'bold 14px'; ctx.fillText(rp.order, rp.x-4, rp.y+5);
                        ctx.fillStyle = '#ffffaa'; ctx.font = '12px monospace';
                        ctx.fillText(`${rp.incAngle}°`, rp.x-12, rp.y-8);
                        ctx.beginPath(); ctx.moveTo(rp.x, rp.y); ctx.lineTo(rp.x + rp.normal.x*22, rp.y + rp.normal.y*22);
                        ctx.strokeStyle = '#ff8888'; ctx.lineWidth = 1.5; ctx.stroke();
                    }
                    ctx.setLineDash([]);
                    let percent = Math.min(1, len/80)*100;
                    powerSlider.value = percent; powerVal.innerText = Math.floor(percent)+'%';
                    ringCtx.clearRect(0,0,width,height);
                    let rad = ballR + 8 + percent/100 * 20;
                    ringCtx.beginPath(); ringCtx.arc(whiteBall.x, whiteBall.y, rad, 0, 2*Math.PI);
                    ringCtx.strokeStyle = '#ffaa33'; ringCtx.lineWidth = 3; ringCtx.stroke();
                }
            } else if(!isAiming){
                powerSlider.value = 0; powerVal.innerText = '0%';
                ringCtx.clearRect(0,0,width,height);
            }
            
            // 碰撞几何
            let displayGeom = collisionEffect.active ? collisionEffect : (showTangentHelper ? lastCollisionGeom : null);
            if(displayGeom && displayGeom.point){
                let p = displayGeom.point, n = displayGeom.normal, t = displayGeom.tangent;
                ctx.beginPath(); ctx.moveTo(circle.x, circle.y); ctx.lineTo(p.x, p.y);
                ctx.strokeStyle = '#ff77aa'; ctx.lineWidth = 2.5; ctx.setLineDash([4,6]); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x + n.x*50, p.y + n.y*50);
                ctx.strokeStyle = '#ff4444'; ctx.lineWidth = 2.5; ctx.stroke();
                ctx.beginPath(); ctx.moveTo(p.x - t.x*50, p.y - t.y*50); ctx.lineTo(p.x + t.x*50, p.y + t.y*50);
                ctx.strokeStyle = '#44aaff'; ctx.lineWidth = 2.5; ctx.stroke();
                let perpX = p.x + n.x*14, perpY = p.y + n.y*14;
                let sideX = perpX + t.x*10, sideY = perpY + t.y*10;
                ctx.beginPath(); ctx.moveTo(perpX, perpY); ctx.lineTo(sideX, sideY); ctx.lineTo(sideX - n.x*10, sideY - n.y*10);
                ctx.strokeStyle = 'white'; ctx.lineWidth = 2; ctx.stroke();
                ctx.fillStyle = 'yellow'; ctx.fillText('⊥', sideX-7, sideY-5);
                ctx.font = "bold 14px monospace"; ctx.fillStyle = '#ffffaa';
                ctx.fillText(`${lang === 'zh' ? '入射' : 'Inc'} ${displayGeom.incAngle.toFixed(0)}°`, p.x + n.x*30-25, p.y + n.y*30-18);
                ctx.fillStyle = '#aaffdd';
                ctx.fillText(`${lang === 'zh' ? '反射' : 'Ref'} ${displayGeom.refAngle.toFixed(0)}°`, p.x + n.x*30-25, p.y + n.y*30+8);
                ctx.fillStyle = '#ffaa88'; ctx.font = 'italic 12px';
                ctx.fillText(`半径 ⊥ 切线`, p.x + n.x*15, p.y + n.y*15-12);
            }
            
            for(let p of particles){
                ctx.beginPath(); ctx.arc(p.x, p.y, 3, 0, 2*Math.PI);
                ctx.fillStyle = '#ffaa44'; ctx.fill();
            }
            
            ctx.restore();
            ctx.beginPath(); ctx.arc(circle.x, circle.y, circle.r, 0, 2*Math.PI);
            ctx.strokeStyle = '#f5e56b'; ctx.lineWidth = 3; ctx.stroke();
        }
        
        function setMode(mode){
            currentMode = mode;
            updateLanguage();
            resetGame();
            drawCanvas();
            playSound('mode');
        }
        
        // 事件绑定
        const scoreSpan = document.getElementById('scoreValue');
        const speedSlider = document.getElementById('speedSlider');
        const speedVal = document.getElementById('speedVal');
        const powerSlider = document.getElementById('powerSlider');
        const powerVal = document.getElementById('powerVal');
        const mobilePowerSlider = document.getElementById('mobilePowerSlider');
        const mobilePowerVal = document.getElementById('mobilePowerVal');
        
        document.getElementById('showGrid').addEventListener('change', (e) => { showGrid = e.target.checked; drawCanvas(); });
        document.getElementById('showRuler').addEventListener('change', (e) => { showRuler = e.target.checked; drawCanvas(); });
        document.getElementById('showTangentHelper').addEventListener('change', (e) => { showTangentHelper = e.target.checked; drawCanvas(); });
        document.getElementById('showPredict').addEventListener('change', (e) => { showPredict = e.target.checked; drawCanvas(); });
        document.getElementById('showParticles').addEventListener('change', (e) => { showParticles = e.target.checked; drawCanvas(); });
        
        function getCoords(e){
            let rect = canvas.getBoundingClientRect();
            let sx = canvas.width/rect.width, sy = canvas.height/rect.height;
            let cx, cy;
            if(e.touches){ cx = e.touches[0].clientX; cy = e.touches[0].clientY; e.preventDefault(); }
            else { cx = e.clientX; cy = e.clientY; }
            return { x: (cx-rect.left)*sx, y: (cy-rect.top)*sy };
        }
        
        function onMouseDown(e){
            e.preventDefault();
            if(isMoving) return;
            let {x,y} = getCoords(e);
            if(Math.hypot(x-whiteBall.x, y-whiteBall.y) <= ballR+5){
                isAiming = true;
                aimEnd = {x:whiteBall.x, y:whiteBall.y};
                drawCanvas();
            }
        }
        function onMouseMove(e){
            if(!isAiming) return;
            e.preventDefault();
            let {x,y} = getCoords(e);
            let dx = x-whiteBall.x, dy = y-whiteBall.y;
            let len = Math.hypot(dx,dy);
            if(len>120){ x = whiteBall.x + dx/len*120; y = whiteBall.y + dy/len*120; }
            aimEnd = {x,y};
            drawCanvas();
        }
        function onMouseUp(e){
            if(!isAiming) return;
            e.preventDefault();
            let dx = aimEnd.x - whiteBall.x, dy = aimEnd.y - whiteBall.y;
            let len = Math.hypot(dx,dy);
            if(len>2){
                let power = computePowerFromDrag(len);
                let vx = dx/len * power, vy = dy/len * power;
                shoot(vx, vy);
            }
            isAiming = false;
            drawCanvas();
        }
        
        canvas.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
        canvas.addEventListener('touchstart', onMouseDown, {passive:false});
        window.addEventListener('touchmove', onMouseMove, {passive:false});
        window.addEventListener('touchend', onMouseUp);
        
        document.getElementById('modeFree').onclick = ()=>setMode('free');
        document.getElementById('modeReflect1').onclick = ()=>setMode('reflect1');
        document.getElementById('modeReflect2').onclick = ()=>setMode('reflect2');
        document.getElementById('modeTangent').onclick = ()=>setMode('tangent');
        document.getElementById('modeAngle').onclick = ()=>setMode('angle');
        document.getElementById('modeChord').onclick = ()=>setMode('chord');
        document.getElementById('modeLab').onclick = ()=>setMode('lab');
        document.getElementById('resetBtn').onclick = ()=>{ resetGame(); drawCanvas(); };
        document.getElementById('undoBtn').onclick = undo;
        document.getElementById('replayBtn').onclick = startReplay;
        
        speedSlider.oninput = (e)=>{ speedFactor = parseFloat(e.target.value); speedVal.innerText = speedFactor.toFixed(2)+'x'; };
        
        // 移动端辅助力度调节
        let mobilePower = 0.8;
        mobilePowerSlider.oninput = (e)=>{
            mobilePower = parseInt(e.target.value) / 100;
            mobilePowerVal.innerText = Math.floor(mobilePower*100)+'%';
        };
        let dirAngleRad = 0;
        document.getElementById('dirUp').onclick = ()=>{ dirAngleRad = -Math.PI/2; };
        document.getElementById('dirDown').onclick = ()=>{ dirAngleRad = Math.PI/2; };
        document.getElementById('dirLeft').onclick = ()=>{ dirAngleRad = Math.PI; };
        document.getElementById('dirRight').onclick = ()=>{ dirAngleRad = 0; };
        document.getElementById('dirShoot').onclick = ()=>{
            if(isMoving) return;
            let vx = Math.cos(dirAngleRad) * 12 * mobilePower;
            let vy = Math.sin(dirAngleRad) * 12 * mobilePower;
            shoot(vx, vy);
        };
        
        let isDark = false;
        document.getElementById('themeBtn').onclick = ()=>{
            isDark = !isDark;
            document.body.classList.toggle('dark-mode', isDark);
            document.body.classList.remove('light-mode');
            if(!isDark) document.body.classList.add('light-mode');
            drawCanvas();
        };
        
        document.getElementById('langBtn').onclick = ()=>{
            lang = lang === 'zh' ? 'en' : 'zh';
            updateLanguage();
            drawCanvas();
        };
        
        document.getElementById('soundToggleBtn').onclick = ()=>{
            soundEnabled = !soundEnabled;
            const t = i18n[lang];
            document.getElementById('soundToggleBtn').innerHTML = soundEnabled ? t.soundOn : t.soundOff;
            if(soundEnabled && !audioCtx) initAudio();
        };
        
        const rulesModal = document.getElementById('rulesModal');
        const rulesBtn = document.getElementById('rulesBtn');
        const closeRulesBtn = document.getElementById('closeRulesBtn');
        rulesBtn.onclick = () => { rulesModal.style.display = 'flex'; };
        closeRulesBtn.onclick = () => { rulesModal.style.display = 'none'; };
        window.onclick = (e) => { if(e.target === rulesModal) rulesModal.style.display = 'none'; };
        
        document.getElementById('helpBtn').onclick = ()=>{
            let modal = document.createElement('div');
            modal.style.position = 'fixed'; modal.style.top='0'; modal.style.left='0'; modal.style.width='100%'; modal.style.height='100%';
            modal.style.background='rgba(0,0,0,0.7)'; modal.style.display='flex'; modal.style.justifyContent='center'; modal.style.alignItems='center'; modal.style.zIndex='2000';
            let content = document.createElement('div');
            content.style.background='white'; content.style.padding='20px'; content.style.borderRadius='24px'; content.style.maxWidth='500px';
            const t = i18n[lang];
            content.innerHTML = `<h3>${t.helpText}</h3><p>${t.ruleFree}<br><br>${t.ruleReflect1}<br><br>${t.ruleTangent}<br><br>${t.ruleAngle}<br><br>${t.ruleChord}<br><br>${t.ruleLab}</p><button id="closeModalBtn" style="margin-top:15px;padding:8px 20px;">${lang === 'zh' ? '关闭' : 'Close'}</button>`;
            modal.appendChild(content);
            document.body.appendChild(modal);
            document.getElementById('closeModalBtn').onclick = ()=>modal.remove();
        };
        
        // 初始化音效 (首次触摸)
        document.body.addEventListener('touchstart', ()=>{ initAudio(); }, { once: true });
        canvas.addEventListener('mousedown', ()=>{ if(!audioCtx && soundEnabled) initAudio(); });
        
        let saved = localStorage.getItem('achievements3');
        if(saved) achievements = JSON.parse(saved);
        updateAchievementsUI();
        
        updateLanguage();
        resetGame();
        drawCanvas();
    })();
</script>
</body>
</html>
